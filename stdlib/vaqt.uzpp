// uz++ — Vaqt (date/time) kutubxonasi, uz++ tilida qayta yozilgan.
// Bu fayl `stdlib/vaqt.hpp` ning manba'si (header.hpp avtomatik tarzda
// uzpp transpilatori orqali shu fayldan generatsiya qilinadi).

ulash <chrono>
ulash <cstdlib>
ulash <ctime>
ulash <iomanip>
ulash <sstream>
ulash <string>
ulash <thread>

nomlar_fazosi uzpp::Vaqt {

tuzilma SanaVaVaqt {
    butun yil;
    butun oy;
    butun kun;
    butun soat;
    butun daqiqa;
    butun soniya;
    matn mintaqa;

    matn formatlash(o'zgarmas matn& format = "%Y-%m-%d %H:%M:%S") o'zgarmas {
        std::tm tm_vaqt;
        tm_vaqt.tm_year = yil - 1900;
        tm_vaqt.tm_mon = oy - 1;
        tm_vaqt.tm_mday = kun;
        tm_vaqt.tm_hour = soat;
        tm_vaqt.tm_min = daqiqa;
        tm_vaqt.tm_sec = soniya;

        std::ostringstream ss;
        ss << std::put_time(&tm_vaqt, format.c_str());
        agar (!mintaqa.empty() && mintaqa != "Local") {
            ss << " (" << mintaqa << ")";
        }
        qaytarish ss.str();
    }
};

funksiya hozir() -> SanaVaVaqt {
    o'zgaruvchan t = std::time(nullptr);
    o'zgaruvchan local_tm = *std::localtime(&t);

    SanaVaVaqt natija;
    natija.yil = local_tm.tm_year + 1900;
    natija.oy = local_tm.tm_mon + 1;
    natija.kun = local_tm.tm_mday;
    natija.soat = local_tm.tm_hour;
    natija.daqiqa = local_tm.tm_min;
    natija.soniya = local_tm.tm_sec;
    natija.mintaqa = "Local";
    qaytarish natija;
}

funksiya mintaqaVaqti(o'zgarmas matn& mintaqa_nomi) -> SanaVaVaqt {
    matn envStr = "TZ=" + mintaqa_nomi;
    putenv(const_cast<belgi*>(envStr.c_str()));
    tzset();

    o'zgaruvchan t = std::time(nullptr);
    o'zgaruvchan local_tm = *std::localtime(&t);
    SanaVaVaqt natija;
    natija.yil = local_tm.tm_year + 1900;
    natija.oy = local_tm.tm_mon + 1;
    natija.kun = local_tm.tm_mday;
    natija.soat = local_tm.tm_hour;
    natija.daqiqa = local_tm.tm_min;
    natija.soniya = local_tm.tm_sec;
    natija.mintaqa = mintaqa_nomi;

    putenv(const_cast<belgi*>(matn("TZ=").c_str()));
    tzset();
    qaytarish natija;
}

funksiya kutish(butun soniya) -> bosh {
    std::this_thread::sleep_for(std::chrono::seconds(soniya));
}

funksiya kutish_ms(butun millisoniya) -> bosh {
    std::this_thread::sleep_for(std::chrono::milliseconds(millisoniya));
}

} // namespace uzpp::Vaqt
