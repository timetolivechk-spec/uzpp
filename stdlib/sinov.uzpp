// uz++ — Sinov (testing) kutubxonasi, uz++ tilida yozilgan.
// Bu fayl `stdlib/sinov.hpp` ning manba'si (header.hpp avtomatik tarzda
// uzpp transpilatori orqali shu fayldan generatsiya qilinadi).

ulash <exception>
ulash <functional>
ulash <iostream>
ulash <stdexcept>
ulash <string>
ulash <chrono>
ulash <vector>

nomlar_fazosi uzpp::Sinov {

// ===== TASDIQLASH (ASSERTIONS) =====

funksiya tasdiqlash(mantiqiy shart, o'zgarmas matn& xabar = "") -> bosh {
    agar (!shart) {
        matn xato = "Tasdiqlash barbod";
        agar (!xabar.empty()) {
            xato = xato + ": " + xabar;
        }
        irgitish std::runtime_error(xato);
    }
}

shablon <tur T>
funksiya tasdiqlash_teng(o'zgarmas T& kutilgan, o'zgarmas T& qiymat, o'zgarmas matn& xabar = "") -> bosh {
    agar (!(kutilgan == qiymat)) {
        irgitish std::runtime_error("Tenglik barbod: kutilgan != qiymat" +
            (xabar.empty() ? matn("") : matn(" — ") + xabar));
    }
}

funksiya tasdiqlash_yaqin(haqiqiy kutilgan, haqiqiy qiymat, haqiqiy epsilon = 0.0001, o'zgarmas matn& xabar = "") -> bosh {
    haqiqiy farq = kutilgan - qiymat;
    agar (farq < 0) {
        farq = -farq;
    }
    agar (farq > epsilon) {
        irgitish std::runtime_error("Yaqinlik barbod: farq > epsilon" +
            (xabar.empty() ? matn("") : matn(" — ") + xabar));
    }
}

// ===== TEST TO'PLAMI =====

sinf TestTo'plami {
    matn nomi_;
    vektor<std::function<void()>> testlar_;
    vektor<matn> nomlar_;

ochiq:
    TestTo'plami(o'zgarmas matn& nom) : nomi_(nom) {}

    bosh test_qoshish(o'zgarmas matn& nom, std::function<void()> test) {
        nomlar_.push_back(nom);
        testlar_.push_back(test);
    }

    butun ishga_tushirish() {
        yozish << qator_oxiri;
        yozish << "=============================================" << qator_oxiri;
        yozish << "  " << nomi_ << qator_oxiri;
        yozish << "=============================================" << qator_oxiri;

        butun otdi = 0;
        butun quladi = 0;
        vektor<matn> qulagan_nomlar;

        uchun (hajm_turi i = 0; i < testlar_.size(); i = i + 1) {
            yozish << "  [" << (i + 1) << "/" << testlar_.size() << "] "
                   << nomlar_[i] << " ... ";

            urinish {
                testlar_[i]();
                yozish << "OTDI" << qator_oxiri;
                otdi = otdi + 1;
            } ushlash (std::exception& e) {
                yozish << "QULADI" << qator_oxiri;
                yozish << "        Sabab: " << e.what() << qator_oxiri;
                quladi = quladi + 1;
                qulagan_nomlar.push_back(nomlar_[i]);
            } ushlash (...) {
                yozish << "QULADI" << qator_oxiri;
                yozish << "        Sabab: noma'lum xato" << qator_oxiri;
                quladi = quladi + 1;
                qulagan_nomlar.push_back(nomlar_[i]);
            }
        }

        yozish << "---------------------------------------------" << qator_oxiri;
        yozish << "  Jami:  " << (otdi + quladi) << qator_oxiri;
        yozish << "  O'tdi: " << otdi << qator_oxiri;
        yozish << "  Quladi:" << quladi << qator_oxiri;

        agar (quladi > 0) {
            yozish << qator_oxiri;
            yozish << "  Qulagan testlar:" << qator_oxiri;
            uchun (hajm_turi i = 0; i < qulagan_nomlar.size(); i = i + 1) {
                yozish << "    - " << qulagan_nomlar[i] << qator_oxiri;
            }
        }

        yozish << "=============================================" << qator_oxiri;
        qaytarish quladi;
    }
};

// ===== BENCHMARK TO'PLAMI =====
//
// `@bench` atributi qo'yilgan funksiyalar shu to'plam orqali ishga
// tushiriladi (`uzpp bench fayl.uzpp`). Har bir funksiya bir necha marta
// takrorlanadi va o'rtacha vaqt chiqariladi.

sinf BenchTo'plami {
    vektor<std::function<void()>> olchovlar_;
    vektor<matn> nomlar_;
    butun takror_ = 1000;

ochiq:
    BenchTo'plami() {}

    bosh takror_belgilash(butun n) {
        agar (n > 0) {
            takror_ = n;
        }
    }

    bosh bench_qoshish(o'zgarmas matn& nom, std::function<void()> olchov) {
        nomlar_.push_back(nom);
        olchovlar_.push_back(olchov);
    }

    butun ishga_tushirish() {
        yozish << qator_oxiri;
        yozish << "=============================================" << qator_oxiri;
        yozish << "  Benchmark (" << takror_ << " marta takrorlash)" << qator_oxiri;
        yozish << "=============================================" << qator_oxiri;

        butun xatolar = 0;

        uchun (hajm_turi i = 0; i < olchovlar_.size(); i = i + 1) {
            yozish << "  [" << (i + 1) << "/" << olchovlar_.size() << "] "
                   << nomlar_[i] << " ... ";

            urinish {
                // Isitish — birinchi chaqiruv kesh va lazy-init ta'sirini yutadi.
                olchovlar_[i]();

                o'zgaruvchan boshlanish = std::chrono::steady_clock::now();
                uchun (butun k = 0; k < takror_; k = k + 1) {
                    olchovlar_[i]();
                }
                o'zgaruvchan tugash = std::chrono::steady_clock::now();

                o'zgaruvchan jami_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(tugash - boshlanish).count();
                haqiqiy ortacha_ns = statik_otkazish<haqiqiy>(jami_ns) / statik_otkazish<haqiqiy>(takror_);

                yozish << ortacha_ns << " ns/amal"
                       << "  (jami " << (statik_otkazish<haqiqiy>(jami_ns) / 1000000.0) << " ms)"
                       << qator_oxiri;
            } ushlash (std::exception& e) {
                yozish << "XATO: " << e.what() << qator_oxiri;
                xatolar = xatolar + 1;
            } ushlash (...) {
                yozish << "XATO: noma'lum" << qator_oxiri;
                xatolar = xatolar + 1;
            }
        }

        yozish << "=============================================" << qator_oxiri;
        qaytarish xatolar;
    }
};

// ===== SODDA TEST FUNKSIYASI (bitta test uchun) =====

funksiya test_bajar(o'zgarmas matn& nom, std::function<void()> test) -> mantiqiy {
    yozish << "  " << nom << " ... ";

    urinish {
        test();
        yozish << "OTDI" << qator_oxiri;
        qaytarish rost;
    } ushlash (std::exception& e) {
        yozish << "QULADI: " << e.what() << qator_oxiri;
        qaytarish yolg'on;
    } ushlash (...) {
        yozish << "QULADI: noma'lum xato" << qator_oxiri;
        qaytarish yolg'on;
    }
}

} // namespace uzpp::Sinov
