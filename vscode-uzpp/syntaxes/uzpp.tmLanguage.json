{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "uz++",
  "scopeName": "source.uzpp",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#class-definition"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#keywords-modifier"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#namespace-access"
    },
    {
      "include": "#template-args"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.uzpp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.uzpp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.uzpp",
          "match": "^\\s*\\b(ulash|ulash_kutubxona|makro)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.uzpp"
            }
          }
        },
        {
          "name": "meta.preprocessor.uzpp",
          "match": "^\\s*#\\s*(include|define|pragma|ifdef|ifndef|endif|else|elif)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.uzpp"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.uzpp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.uzpp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "class-definition": {
      "comment": "Highlights class/struct name after 'sinf' or 'tuzilma'",
      "match": "\\b(sinf|tuzilma|shartnoma)\\s+([a-zA-Z_][a-zA-Z0-9_']*)",
      "captures": {
        "1": {
          "name": "storage.type.class.uzpp"
        },
        "2": {
          "name": "entity.name.type.uzpp"
        }
      }
    },
    "function-definition": {
      "comment": "ReturnType FunctionName( — highlights the function name",
      "match": "(?<!\\.)\\b([a-zA-Z_][a-zA-Z0-9_']*)\\s*(?=\\([^;]*\\)\\s*(?::|\\{|ustidan_yozish|mavhum))",
      "captures": {
        "1": {
          "name": "entity.name.function.definition.uzpp"
        }
      }
    },
    "keywords-control": {
      "name": "keyword.control.uzpp",
      "match": "\\b(agar|aks_holda|boshqa|uchun|toki|bajar|moslash|holat|qaytarish|to'xtatish|davom_etish|urinish|ushlash|irgitish|kutish|chiqar_qadam|shart|statik_tasdiqlash)\\b"
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "storage.type.class.uzpp",
          "match": "\\b(sinf|tuzilma|birlashma|sanab_olish|shartnoma)\\b"
        },
        {
          "name": "keyword.declaration.uzpp",
          "match": "\\b(shablon|tur|nomlar_fazosi|funksiya|ulash|ulash_kutubxona|eksport|import|modul|tushuncha|makro|asinxron|meros|amalga_oshirish|dust)\\b"
        }
      ]
    },
    "keywords-modifier": {
      "name": "storage.modifier.uzpp",
      "match": "\\b(o'zgaruvchan|o'zgarmas|ochiq|yopiq|himoyalangan|mavhum|ustidan_yozish|statik|qator_ichi|tashqi|oqim_mahalliy|xato_tashlamaydi|sobit_ifoda|sobit_baholash|sobit_boshlangich|statik_otkazish|dinamik_otkazish|o'zgarmas_otkazish|qayta_otkazish|tur_baholash|yangi|o'chirish)\\b"
    },
    "types": {
      "name": "support.type.uzpp",
      "match": "\\b(butun|butun8|butun16|butun32|butun64|musbat_butun|musbat_butun8|musbat_butun16|musbat_butun32|musbat_butun64|qisqa|musbat_qisqa|uzun|uzun_uzun|musbat_uzun|musbat_uzun_uzun|hajm_turi|haqiqiy|kasr|mantiqiy|belgi|musbat_belgi|matn|bosh|vektor|lug'at|tartiblangan_xarita|to'plam_noyob|tartib_to'plam|ikki_tomonlama_navbat|juftlik|uchlik|massiv|ixtiyoriy|variant|Natija|Tanlov|kelajak|vada|oqim|qulf|umumiy_qulf|atomik|umumiy_korsatkich|yagona_korsatkich|kuchsiz_korsatkich|fayl_oqish|fayl_yozish|boshlovchi_royxat|manba_joyi|funksiya)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.uzpp",
          "match": "\\b(rost|yolg'on)\\b"
        },
        {
          "name": "constant.language.null.uzpp",
          "match": "\\b(null|nullptr|NULL)\\b"
        },
        {
          "name": "constant.language.uzpp",
          "match": "\\b(rost|yolg'on|va|yoki|bu|oz|null|nullptr)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.uzpp",
          "match": "\\b0[xX][0-9a-fA-F]+[uUlL]*\\b"
        },
        {
          "name": "constant.numeric.float.uzpp",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?[fFlL]?\\b"
        },
        {
          "name": "constant.numeric.integer.uzpp",
          "match": "\\b\\d+[uUlL]*\\b"
        }
      ]
    },
    "function-call": {
      "comment": "Any identifier immediately followed by ( — function/method call",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_']*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.uzpp"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.uzpp",
          "match": "\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.comparison.uzpp",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.uzpp",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.uzpp",
          "match": "&=|\\|=|\\^=|<<=|>>=|&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.assignment.uzpp",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.uzpp",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.scope.uzpp",
          "match": "::"
        }
      ]
    },
    "namespace-access": {
      "comment": "Highlights namespace/type qualifiers like uzpp::, std::",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_']*)(?=::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.uzpp"
        }
      }
    },
    "template-args": {
      "comment": "Type parameter T in shablon<tur T>",
      "match": "\\b(tur|typename)\\s+([a-zA-Z_][a-zA-Z0-9_']*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.uzpp"
        },
        "2": {
          "name": "entity.name.type.parameter.uzpp"
        }
      }
    }
  }
}
