// `yangi Tur{a, b}` — new + qavsli (brace) initsializatsiya.
// Agregat tuzilmalarda konstruktor yo'q, shuning uchun qavsli shakl
// yagona tabiiy yo'l. Ilgari faqat `yangi Tur(a, b)` ishlardi.
ulash "uzpp_runtime.hpp"

tuzilma Tugun {
    butun qiymat;
    Tugun* keyingi;
};

butun asosiy() {
    Tugun* birinchi = yangi Tugun{10, nullptr};
    Tugun* ikkinchi = yangi Tugun{20, nullptr};
    Tugun* uchinchi = yangi Tugun{30, nullptr};

    birinchi->keyingi = ikkinchi;
    ikkinchi->keyingi = uchinchi;

    butun yigindi = 0;
    Tugun* joriy = birinchi;
    toki (joriy != nullptr) {
        yozish << joriy->qiymat << " ";
        yigindi += joriy->qiymat;
        joriy = joriy->keyingi;
    }
    yozish << qator_oxiri;

    o'chirish birinchi;
    o'chirish ikkinchi;
    o'chirish uchinchi;

    agar (yigindi == 60) {
        yozish << "=== MUVAFFAQIYATLI ===" << qator_oxiri;
        qaytarish 0;
    }

    yozish << "=== XATO ===" << qator_oxiri;
    qaytarish 1;
}
