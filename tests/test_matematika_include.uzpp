// uz++ — `matematika` kutubxonasini sinovchi test.
// `ulash "matematika.uzpp"` orqali ishlatilishini tekshiradi.

ulash "uzpp_runtime.hpp"
ulash "matematika.uzpp"

butun asosiy() {
    // Konstantalar
    yozish << "PI: " << uzpp::Matematika::PI() << qator_oxiri;
    yozish << "E:  " << uzpp::Matematika::E_soni() << qator_oxiri;

    // Asosiy funksiyalar
    yozish << "modul(-5): " << uzpp::Matematika::modul(-5) << qator_oxiri;
    yozish << "daraja(2, 3): " << uzpp::Matematika::daraja(2, 3) << qator_oxiri;
    yozish << "ildiz(16): " << uzpp::Matematika::ildiz(16) << qator_oxiri;
    yozish << "yuqori_yaxlitlash(3.14): " << uzpp::Matematika::yuqori_yaxlitlash(3.14) << qator_oxiri;
    yozish << "quyi_yaxlitlash(3.14): " << uzpp::Matematika::quyi_yaxlitlash(3.14) << qator_oxiri;
    yozish << "yaxlitlash(3.5): " << uzpp::Matematika::yaxlitlash(3.5) << qator_oxiri;

    // Sonlarni tekshirish
    yozish << "sonMi(42): " << uzpp::Matematika::sonMi(42) << qator_oxiri;
    yozish << "toqMi(7): " << uzpp::Matematika::toqMi(7) << qator_oxiri;
    yozish << "juftMi(8): " << uzpp::Matematika::juftMi(8) << qator_oxiri;
    yozish << "tub_sonMi(17): " << uzpp::Matematika::tub_sonMi(17) << qator_oxiri;
    yozish << "tub_sonMi(15): " << uzpp::Matematika::tub_sonMi(15) << qator_oxiri;

    // EKUB va EKUK
    yozish << "ekub(12, 8): " << uzpp::Matematika::ekub(12, 8) << qator_oxiri;
    yozish << "ekuk(12, 8): " << uzpp::Matematika::ekuk(12, 8) << qator_oxiri;

    // Faktorial va kombinatsiya
    yozish << "faktorial(5): " << uzpp::Matematika::faktorial(5) << qator_oxiri;
    yozish << "kombinatsiya(5, 2): " << uzpp::Matematika::kombinatsiya(5, 2) << qator_oxiri;

    // Vektor2
    uzpp::Matematika::Vektor2 v1;
    v1.x = 3.0;
    v1.y = 4.0;
    yozish << "Vektor2 uzunlik(3,4): " << v1.uzunlik() << qator_oxiri;

    uzpp::Matematika::Vektor2 v2;
    v2.x = 1.0;
    v2.y = 2.0;
    o'zgaruvchan v3 = v1 + v2;
    yozish << "Vektor2 qo'shish: (" << v3.x << ", " << v3.y << ")" << qator_oxiri;

    qaytarish 0;
}
